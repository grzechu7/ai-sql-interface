// ✅ passport.js — ESM, bezpieczna obsługa Local, Google i JWT + logi debug

import passport from "passport";
import { Strategy as LocalStrategy } from "passport-local";
import { Strategy as GoogleStrategy } from "passport-google-oauth20";
import { Strategy as JwtStrategy, ExtractJwt } from "passport-jwt";
import bcrypt from "bcrypt";
import jwt from "jsonwebtoken";
import mysql from "mysql2/promise";
import dotenv from "dotenv";

dotenv.config();

console.log("🚀 [passport.js] Ładowanie...");
process.on("uncaughtException", (err) => {
  console.error("💥 NIEZŁAPANY WYJĄTEK (uncaught):", err);
});


// =======================================
// 🔹 GLOBALNE POŁĄCZENIE Z BAZĄ AUTH
// =======================================
export let dbAuth;

try {
  dbAuth = await mysql.createPool({
    host: process.env.MYSQL_AUTH_HOST || process.env.MYSQL_HOST,
    port: process.env.MYSQL_AUTH_PORT || process.env.MYSQL_PORT,
    user: process.env.MYSQL_AUTH_USER || process.env.MYSQL_USER,
    password: process.env.MYSQL_AUTH_PASSWORD || process.env.MYSQL_PASSWORD,
    database: process.env.MYSQL_AUTH_DATABASE || process.env.MYSQL_DATABASE,
    connectionLimit: 10,
    waitForConnections: true,
    queueLimit: 0,
  });

  console.log(`✅ [passport.js] Połączono z bazą: ${process.env.MYSQL_AUTH_DATABASE || process.env.MYSQL_DATABASE}`);
} catch (err) {
  console.error("❌ [passport.js] Błąd połączenia z bazą:", err);
  throw err;
}


// =======================================
// 🔹 STRATEGIA LOKALNA (email + hasło)
// =======================================
passport.use(
  new LocalStrategy(
    { usernameField: "email", passwordField: "password" },
    async (email, password, done) => {
      console.log("🧩 [LocalStrategy] Próba logowania dla:", email); // Log przed zapytaniem SQL

      try {
        // Logowanie przed zapytaniem SQL
        console.log("[LocalStrategy] Zapytanie SQL do bazy: email =", email);

        // Wykonaj zapytanie SQL do bazy
        const [rows] = await dbAuth.execute(
          "SELECT id, email, password_hash, is_active FROM users WHERE email = ?",
          [email]
        );

        // Logowanie wyników zapytania
        console.log("[LocalStrategy] Wyniki zapytania:", rows);

        if (!rows?.length) {
          console.warn("🚫 [LocalStrategy] Brak użytkownika:", email); // Log, gdy brak użytkownika
          return done(null, false, { message: "Nieprawidłowy e-mail lub hasło" });
        }

        const user = rows[0];
        if (!user.password_hash) {
          console.error("⚠️ [LocalStrategy] Brak pola password_hash dla:", user.email); // Log, gdy brak hasła w bazie
          return done(null, false, { message: "Brak hasła w bazie" });
        }

        // Sprawdzenie hasła
        const isMatch = await bcrypt.compare(password, user.password_hash);
        if (!isMatch) {
          console.warn("🚫 [LocalStrategy] Błędne hasło dla:", user.email); // Log, gdy hasło nie pasuje
          return done(null, false, { message: "Nieprawidłowy e-mail lub hasło" });
        }

        // Sprawdzenie aktywności konta
        if (user.is_active === 0) {
          console.warn("⛔ [LocalStrategy] Konto nieaktywne:", user.email); // Log, gdy konto jest nieaktywne
          return done(null, false, { message: "Konto nieaktywne" });
        }

        console.log(`✅ [LocalStrategy] Zalogowano: ${user.email} (id=${user.id})`);
        
        // Logowanie przed ustawieniem sesji
        console.log("🟢 Przed ustawieniem sesji dla użytkownika:", email);

        req.login(user, (err) => { // Funkcja odpowiedzialna za utworzenie sesji
          if (err) {
            console.error("❌ Błąd ustawiania sesji:", err); // Log błędu sesji
            return done(null, false, { message: "Błąd sesji logowania" });
          }

          console.log(`✅ Sesja ustawiona dla użytkownika: ${user.email}`);
          return done(null, user); // Zalogowano pomyślnie, sesja ustawiona
        });

      } catch (err) {
        console.error("💥 [LocalStrategy ERROR — stack]:", err); // Log błędu
        return done(null, false, { message: "Błąd serwera podczas logowania" });
      }
    }
  )
);





// Serializowanie użytkownika (tworzenie sesji)
passport.serializeUser((user, done) => {
  console.log("🟢 [serializeUser] zapisuję id:", user.id);
  done(null, user.id);
});

// Deserializowanie użytkownika (sprawdzanie sesji)
passport.deserializeUser(async (id, done) => {
  try {
    console.log("[deserializeUser] Sprawdzanie sesji dla użytkownika:", id);

    const [rows] = await dbAuth.execute("SELECT * FROM users WHERE id = ?", [id]);
    if (!rows.length) {
      console.warn("⚠️ [deserializeUser] Brak użytkownika o id:", id);
      return done(null, false);
    }
    console.log("🟢 [deserializeUser] użytkownik:", rows[0].email);
    done(null, rows[0]);
  } catch (err) {
    console.error("❌ [deserializeUser ERROR]:", err);
    done(err, false);
  }
});






// =======================================
// 🔹 STRATEGIA JWT
// =======================================
const jwtOpts = {
  jwtFromRequest: ExtractJwt.fromAuthHeaderAsBearerToken(),
  secretOrKey: process.env.JWT_SECRET || "Grzechu123$%",
};

passport.use(
  new JwtStrategy(jwtOpts, async (payload, done) => {
    try {
      const [rows] = await dbAuth.execute("SELECT id, email FROM users WHERE id = ?", [payload.id]);
      if (!rows.length) return done(null, false);
      done(null, rows[0]);
    } catch (err) {
      console.error("💥 [JWTStrategy ERROR]:", err);
      done(err, false);
    }
  })
);

// =======================================
// 🔹 GENEROWANIE TOKENU JWT
// =======================================
export function generateToken(user) {
  try {
    const token = jwt.sign(
      { id: user.id, email: user.email },
      process.env.JWT_SECRET || "Grzechu123$%",
      { expiresIn: "24h" }
    );
    console.log("🔐 [JWT] Token wygenerowany dla:", user.email);
    return token;
  } catch (err) {
    console.error("💥 [JWT] Błąd generowania tokenu:", err);
    throw err;
  }
}

// =======================================
// 🔹 SERIALIZACJA / DESERIALIZACJA
// =======================================
passport.serializeUser((user, done) => {
  console.log("🟢 [serializeUser] zapisuję id:", user.id);
  done(null, user.id);
});

passport.deserializeUser(async (id, done) => {
  try {
    const [rows] = await dbAuth.execute("SELECT * FROM users WHERE id = ?", [id]);
    if (!rows.length) {
      console.warn("⚠️ [deserializeUser] brak użytkownika o id:", id);
      return done(null, false);
    }
    console.log("🟢 [deserializeUser] użytkownik:", rows[0].email);
    done(null, rows[0]);
  } catch (err) {
    console.error("❌ [deserializeUser ERROR]:", err);
    done(err);
  }
});

export default passport;
