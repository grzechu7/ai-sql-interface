// === db.js — stabilne połączenia z MySQL (dotenv + mysql2/promise) ===
import mysql from "mysql2/promise";
import dotenv from "dotenv";

// 🔹 Wczytaj zmienne środowiskowe z pliku .env
dotenv.config();

// 🔹 Pomocnicze logi
const log = (msg) => console.log(`[DB] ${msg}`);
const logErr = (msg, err) =>
  console.error(`[DB] ❌ ${msg}:`, err?.message || err);

// === KONFIGURACJA: baza z danymi aplikacji (np. homeso_wycena) ===
const dataConfig = {
  host: process.env.MYSQL_DATA_HOST || "localhost",
  user: process.env.MYSQL_DATA_USER || process.env.MYSQL_USER || "root",
  password: process.env.MYSQL_DATA_PASSWORD || process.env.MYSQL_PASSWORD || "",
  database: process.env.MYSQL_DATA_DATABASE || "",
  port: Number(process.env.MYSQL_DATA_PORT || 3306),
  waitForConnections: true,
  connectionLimit: 10,
  queueLimit: 0,
  enableKeepAlive: true,
};

// === KONFIGURACJA: baza autoryzacyjna (np. aisql) ===
const authConfig = {
  host: process.env.MYSQL_AUTH_HOST || "localhost",
  user: process.env.MYSQL_AUTH_USER || process.env.MYSQL_USER || "root",
  password: process.env.MYSQL_AUTH_PASSWORD || process.env.MYSQL_PASSWORD || "",
  database: process.env.MYSQL_AUTH_DATABASE || "",
  port: Number(process.env.MYSQL_AUTH_PORT || 3306),
  waitForConnections: true,
  connectionLimit: 5,
  queueLimit: 0,
  enableKeepAlive: true,
};

// === TWORZENIE POOLI ===
export const dbData = mysql.createPool(dataConfig);
export const dbAuth = mysql.createPool(authConfig);

// === TESTY POŁĄCZEŃ ===
(async () => {
  try {
    await dbData.query("SELECT 1");
    log(`✅ Połączono z bazą danych: ${process.env.MYSQL_DATA_DATABASE}`);
  } catch (err) {
    logErr("Błąd połączenia z główną bazą danych", err);
  }

  try {
    await dbAuth.query("SELECT 1");
    log(`✅ Połączono z bazą autoryzacyjną: ${process.env.MYSQL_AUTH_DATABASE}`);
  } catch (err) {
    logErr("Błąd połączenia z bazą autoryzacyjną", err);
  }
})();

// === ZAMYKANIE POŁĄCZEŃ ===
process.on("SIGINT", async () => {
  log("Zamykanie połączeń z bazami danych...");
  try {
    await dbData.end();
    await dbAuth.end();
    log("🛑 Połączenia zamknięte.");
  } catch (err) {
    logErr("Błąd przy zamykaniu połączeń", err);
  } finally {
    process.exit(0);
  }
});
