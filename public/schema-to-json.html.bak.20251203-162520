  <!-- 🔽 Nowy skrypt – przekierowanie dla linków schema-query.html -->
  <script>
  document.addEventListener("DOMContentLoaded", () => {
    const schemaLinks = document.querySelectorAll('a[href="/schema-query.html"]');

    async function isLoggedIn() {
      try {
        const res = await fetch("/api/auth/me", { credentials: "include" });
        return res.ok;
      } catch {
        return false;
      }
    }

    schemaLinks.forEach(link => {
      link.addEventListener("click", async (e) => {
        e.preventDefault();
        const loggedIn = await isLoggedIn();
        if (loggedIn) {
          window.location.href = "/schema-query.html"; // ✅ zalogowany
        } else {
          window.location.href = "/login.html"; // ❌ niezalogowany
        }
      });
    });
