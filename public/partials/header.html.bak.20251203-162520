<header class="header">
  <div class="header-inner">
    <a class="brand" href="/index.html" aria-label="AI-SQL-Chat - strona główna">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M4 7c0-1.657 3.582-3 8-3s8 1.343 8 3-3.582 3-8 3-8-1.343-8-3Z" stroke="currentColor" stroke-width="1.5"/>
        <path d="M4 7v10c0 1.657 3.582 3 8 3s8-1.343 8-3V7" stroke="currentColor" stroke-width="1.5"/>
        <path d="M20 12c0 1.657-3.582 3-8 3s-8-1.343-8-3" stroke="currentColor" stroke-width="1.5"/>
      </svg>
      <span class="name">AI-SQL-Chat</span>
      <img src="/img/owner.png" alt="Owner" class="avatar" />
      <span class="byline">
        created by
        <a href="mailto:podkowa71@gmail.com" rel="author">Grzegorz Parczewski</a>
      </span>
    </a>

    <!-- Hamburger (mobile) -->
    <button class="nav-toggle" id="navToggle" aria-label="Menu" aria-controls="mainmenu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>

    <nav id="mainmenu" class="nav" role="navigation">
      <!-- Przyciski logowania/rejestracji -->
      <span id="authLinks">
        <a class="link" href="/login.html" id="loginLink">Zaloguj</a>
        <a class="link" href="/register.html" id="registerLink">Zarejestruj</a>
      </span>

      <!-- Zmieniane dynamicznie po zalogowaniu -->
      <a class="link" href="#" id="logoutLink" style="display:none;">Wyloguj</a>

      <a class="btn btn-secondary" href="/schema-paste.html">Wklej schemat</a>
      <a class="btn btn-secondary" href="/schema-query.html" id="loadSchemaBtn" style="display:none;">Załaduj schemat</a>
      <a class="btn btn-primary" href="/sql-query.html">Wypróbuj demo</a>
    </nav>
  </div>
</header>

<script>
// === PROSTA KONTROLA SESJI W HEADERZE ===

async function apiFetch(path, options = {}) {
  const url = path.startsWith("http") ? path : (path.startsWith("/api") ? path : "/api" + path);
  return fetch(url, {
    ...options,
    credentials: "include", // 🔑 ważne! — wysyła i odbiera ciasteczka sesji
  });
}

async function checkSessionAndToggleButtons() {
  const login = document.getElementById("loginLink");
  const register = document.getElementById("registerLink");
  const logout = document.getElementById("logoutLink");
  const loadSchema = document.getElementById("loadSchemaBtn");

  try {
    const res = await apiFetch("/api/auth/me");

    if (res.ok) {
      // ✅ zalogowany — pokaż "Załaduj schemat", ukryj login/rejestrację
      if (login) login.style.display = "none";
      if (register) register.style.display = "none";
      if (logout) logout.style.display = "inline-block";
      if (loadSchema) loadSchema.style.display = "inline-block";
    } else {
      // ❌ niezalogowany — ukryj "Załaduj schemat"
      if (login) login.style.display = "inline-block";
      if (register) register.style.display = "inline-block";
      if (logout) logout.style.display = "none";
      if (loadSchema) loadSchema.style.display = "none";
    }
  } catch (err) {
    console.warn("⚠️ Błąd przy sprawdzaniu sesji:", err);
    if (loadSchema) loadSchema.style.display = "none";
  }
}

function attachLogoutHandler() {
  const logout = document.getElementById("logoutLink");
  if (logout && !logout.dataset.bound) {
    logout.dataset.bound = "true";
    logout.addEventListener("click", async (e) => {
      e.preventDefault();
      try {
        await apiFetch("/api/auth/logout", { method: "POST" });
        location.reload(); // 🔁 po wylogowaniu — odśwież stronę
      } catch (err) {
        alert("❌ Błąd wylogowania");
      }
    });
  }
}

document.addEventListener("DOMContentLoaded", () => {
  // 🔄 Poczekaj aż include.js wstawi header, potem sprawdź sesję
  setTimeout(() => {
    checkSessionAndToggleButtons();
    attachLogoutHandler();
  }, 400);
});
</script>


