  <!-- Helpery API (prefiks /api z automatycznym fallbackiem) -->
  <script>
  async function apiFetch(path, options = {}) {
    const urlWithApi = path.startsWith('/api/') ? path : '/api' + path;
    try {
      const r1 = await fetch(urlWithApi, options);
      if (r1.status !== 404) return r1;
    } catch(e) { /* CORS/Network – spróbuj bez prefiksu */ }
    return fetch(path, options);
  }
  async function readError(res) {
    const ct = res.headers.get('content-type') || '';
    try {
      if (ct.includes('application/json')) {
        const j = await res.json();
        return JSON.stringify(j);
      }
      return await res.text();
    } catch { return '(brak treści błędu)'; }
  }
  </script>

  <!-- Logika strony -->
  <script>
    const DEFAULT_SCHEMA = `{
  "tables": [
    { "name": "customers", "columns": [
      { "name": "id", "type": "INTEGER", "pk": true },
      { "name": "email", "type": "TEXT" },
      { "name": "created_at", "type": "TIMESTAMP" }
    ]},
    { "name": "orders", "columns": [
      { "name": "id", "type": "INTEGER", "pk": true },
      { "name": "customer_id", "type": "INTEGER", "fk": "customers.id" },
      { "name": "amount", "type": "DECIMAL" },
      { "name": "status", "type": "TEXT" },
      { "name": "created_at", "type": "TIMESTAMP" }
    ]}
  ]
}`;

    const schemaBox = document.getElementById('schemaBox');
    schemaBox.value = DEFAULT_SCHEMA;
    renderSchemaPreview();

    function useSample(){
      schemaBox.value = DEFAULT_SCHEMA;
      renderSchemaPreview();
    }
    function renderSchemaPreview(){
      try{
        const obj = JSON.parse(schemaBox.value);
        const out = [];
        (obj.tables||[]).forEach(t=>{
          out.push(`<div class="card" style="padding:10px; margin:10px 0">
            <div style="font-weight:600; margin-bottom:6px">📦 ${t.name}</div>
            <ul style="margin:0; padding-left:18px; line-height:1.6">
              ${(t.columns||[]).map(c=>`<li>${c.name}${c.pk?' (PK)':''}${c.fk?` → ${c.fk}`:''} : ${c.type}</li>`).join('')}
            </ul>
          </div>`);
        });
        document.getElementById('schemaPreview').innerHTML = out.join('') || 'Brak tabel.';
      }catch{
        document.getElementById('schemaPreview').innerHTML = '<span style="color:#ef4444">Niepoprawny JSON.</span>';
      }
    }
    schemaBox.addEventListener('input', renderSchemaPreview);

    function clearPrompt(){
      const qp = document.getElementById('qPrompt');
      if (qp) qp.value = '';
      const q = document.getElementById('q');
      if (q) q.value = '';
      document.getElementById('resultSection').style.display = 'none';
      document.getElementById('sql').textContent = '-- Tu pojawi się wygenerowane zapytanie SQL\n';
    }

    async function onGenerateClick(){
      const qVal =
        (document.getElementById('qPrompt')?.value || '').trim() ||
        (document.getElementById('q')?.value || '').trim();

      const l1 = document.getElementById('loading');
      const l2 = document.getElementById('loading2');
      if(!qVal){ return alert('Wpisz opis zapytania.'); }

      if (l1) l1.textContent = '⏳ Generuję i wykonuję...';
      if (l2) l2.textContent = '⏳ Generuję i wykonuję...';

      try {
       let resp = await apiFetch('/api/ask', {
  method:'POST',
  headers:{'Content-Type':'application/json'},
  body: JSON.stringify({ question: qVal })
});


        if (!resp.ok) {
          const errText = await readError(resp);
          alert(`Błąd serwera (${resp.status}): ${errText}`);
          return;
        }

        const data = await resp.json().catch(()=> ({}));

        if (data.sqlFileId) {
          const sqlResp = await apiFetch('/sql/' + encodeURIComponent(data.sqlFileId));
          const sqlText = await sqlResp.text();
          document.getElementById('sql').textContent = sqlText || '-- (brak danych)\n';
        } else if (data.sql) {
          document.getElementById('sql').textContent = data.sql || '-- (brak danych)\n';
        } else {
          document.getElementById('sql').textContent = '-- (brak danych)\n';
        }

        const rows = data.rows || [];
        document.getElementById('rowCount').textContent = rows.length ? rows.length+' wierszy' : 'Brak danych';
        document.getElementById('result').innerHTML = renderTable(rows);
        document.getElementById('resultSection').style.display = 'block';
        document.getElementById('resultSection').scrollIntoView({behavior:'smooth', block:'start'});
      } catch (e) {
        alert('Błąd połączenia z serwerem: ' + (e?.message || e));
      } finally {
        if (l1) l1.textContent = '';
        if (l2) l2.textContent = '';
      }
    }

    function renderTable(rows){
      if(!rows.length) return '<div class="empty">Brak wyników.</div>';
      const cols = Object.keys(rows[0]);
      const thead = '<thead><tr>'+cols.map(c=>`<th>${esc(c)}</th>`).join('')+'</tr></thead>';
      const tbody = '<tbody>'+rows.map(r=>'<tr>'+cols.map(c=>`<td>${esc(r[c])}</td>`).join('')+'</tr>').join('')+'</tbody>';
      return `<div class="table-scroll"><table>${thead}${tbody}</table></div>`;
    }
    const esc = s=> s==null?'':String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');

    function copySql(){
      const code = document.getElementById('sql').textContent || '';
      if(code) navigator.clipboard.writeText(code);
    }
    function downloadSql(){
      const code = document.getElementById('sql').textContent || '';
      if(!code) return;
      const blob = new Blob([code],{type:'text/plain;charset=utf-8'});
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a'); a.href = url; a.download = 'query.sql'; a.click();
      URL.revokeObjectURL(url);
    }

    (function fillYear(){
      const nodes = document.querySelectorAll('.js-year');
      if (nodes.length) {
        const y = new Date().getFullYear();
        nodes.forEach(n => n.textContent = y);
      } else {
        setTimeout(fillYear, 120);
      }
    })();
  </script>

